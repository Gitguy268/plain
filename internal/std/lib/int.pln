// Whole-number helpers.

pub extern fn abs(n: Int) -> Int = "$int_mod.abs"
pub extern fn min(a: Int, b: Int) -> Int = "$int_mod.min"
pub extern fn max(a: Int, b: Int) -> Int = "$int_mod.max"
pub extern fn clamp(n: Int, low: Int, high: Int) -> Int = "$int_mod.clamp"

pub fn is_even(n: Int) -> Bool {
  n % 2 == 0
}
