// Lists never change: every function here returns a new list.

pub extern fn len[T](xs: List[T]) -> Int = "$list.len"
pub extern fn is_empty[T](xs: List[T]) -> Bool = "$list.is_empty"
pub extern fn get[T](xs: List[T], index: Int) -> Option[T] = "$list.get"
pub extern fn first[T](xs: List[T]) -> Option[T] = "$list.first"
pub extern fn last[T](xs: List[T]) -> Option[T] = "$list.last"
pub extern fn map[A, B](xs: List[A], f: fn(A) -> B) -> List[B] = "$list.map"
pub extern fn filter[T](xs: List[T], keep: fn(T) -> Bool) -> List[T] = "$list.filter"
pub extern fn fold[T, A](xs: List[T], start: A, f: fn(A, T) -> A) -> A = "$list.fold"
pub extern fn each[T](xs: List[T], f: fn(T)) = "$list.each"
pub extern fn push[T](xs: List[T], item: T) -> List[T] = "$list.push"
pub extern fn reverse[T](xs: List[T]) -> List[T] = "$list.reverse"
pub extern fn sort[T](xs: List[T]) -> List[T] = "$list.sort"
pub extern fn sort_by[T, K](xs: List[T], key: fn(T) -> K) -> List[T] = "$list.sort_by"
pub extern fn range(from: Int, to: Int) -> List[Int] = "$list.range"
pub extern fn indices[T](xs: List[T]) -> List[Int] = "$list.indices"
pub extern fn contains[T](xs: List[T], item: T) -> Bool = "$list.contains"
pub extern fn find[T](xs: List[T], matches: fn(T) -> Bool) -> Option[T] = "$list.find"
pub extern fn index_of[T](xs: List[T], item: T) -> Option[Int] = "$list.index_of"
pub extern fn any[T](xs: List[T], matches: fn(T) -> Bool) -> Bool = "$list.any"
pub extern fn all[T](xs: List[T], matches: fn(T) -> Bool) -> Bool = "$list.all"
pub extern fn count[T](xs: List[T], matches: fn(T) -> Bool) -> Int = "$list.count"
pub extern fn join(xs: List[String], separator: String) -> String = "$list.join"
pub extern fn sum(xs: List[Int]) -> Int = "$list.sum"
pub extern fn sum_float(xs: List[Float]) -> Float = "$list.sum_float"
pub extern fn take[T](xs: List[T], n: Int) -> List[T] = "$list.take"
pub extern fn drop[T](xs: List[T], n: Int) -> List[T] = "$list.drop"
pub extern fn flat_map[A, B](xs: List[A], f: fn(A) -> List[B]) -> List[B] = "$list.flat_map"
pub extern fn repeat[T](item: T, times: Int) -> List[T] = "$list.repeat"
pub extern fn unique[T](xs: List[T]) -> List[T] = "$list.unique"
