// Text functions. Lengths and positions count characters, not bytes.

pub extern fn len(s: String) -> Int = "$string.len"
pub extern fn is_empty(s: String) -> Bool = "$string.is_empty"
pub extern fn upper(s: String) -> String = "$string.upper"
pub extern fn lower(s: String) -> String = "$string.lower"
pub extern fn trim(s: String) -> String = "$string.trim"
pub extern fn split(s: String, separator: String) -> List[String] = "$string.split"
pub extern fn lines(s: String) -> List[String] = "$string.lines"
pub extern fn chars(s: String) -> List[String] = "$string.chars"
pub extern fn contains(s: String, part: String) -> Bool = "$string.contains"
pub extern fn starts_with(s: String, prefix: String) -> Bool = "$string.starts_with"
pub extern fn ends_with(s: String, suffix: String) -> Bool = "$string.ends_with"
pub extern fn replace(s: String, old: String, new_text: String) -> String = "$string.replace"
pub extern fn slice(s: String, from: Int, to: Int) -> String = "$string.slice"
pub extern fn index_of(s: String, part: String) -> Option[Int] = "$string.index_of"
pub extern fn repeat(s: String, times: Int) -> String = "$string.repeat"
pub extern fn reverse(s: String) -> String = "$string.reverse"
pub extern fn pad_left(s: String, width: Int, fill: String = " ") -> String = "$string.pad_left"
pub extern fn pad_right(s: String, width: Int, fill: String = " ") -> String = "$string.pad_right"
